<Window x:Class="Mike.Desktop.TranslationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mike Tradutor" Width="1040" Height="720" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#0E1420" Foreground="#F4F8FF">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#15BEE5"/><Setter Property="Foreground" Value="#07131C"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#151F2E"/><Setter Property="Foreground" Value="#F4F8FF"/><Setter Property="BorderBrush" Value="#314158"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/></Style>
  </Window.Resources>
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Mike Tradutor" FontSize="31" FontWeight="Bold"/><TextBlock Text="Mangás, livros, documentos e legendas — local, retomável e com memória por projeto." Foreground="#A9B6C9" Margin="0,5,0,22"/></StackPanel>
    <TabControl Grid.Row="1" Background="#101927" BorderBrush="#2C3B51">
      <TabItem Header="Mangá / Webtoon"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Cole a URL exata. Capítulo traduz aquele capítulo; série prepara a fila completa." TextWrapping="Wrap" Margin="0,0,0,12"/><TextBox x:Name="MangaUrl" Grid.Row="1" Height="74" AcceptsReturn="True" TextWrapping="Wrap"/><StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,14,0,0"><Button Content="Traduzir URL" Click="StartManga_Click"/><Button Content="Abrir resultados" Click="OpenTranslations_Click" Background="#27364A" Foreground="White"/></StackPanel></Grid></TabItem>
      <TabItem Header="Documento / Livro"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="TXT, Markdown, SRT, VTT, DOCX e EPUB. O original nunca é substituído." Margin="0,0,0,12"/><DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="Escolher arquivo" Click="ChooseDocument_Click" Margin="10,0,0,0"/><TextBox x:Name="DocumentPath" VerticalContentAlignment="Center"/></DockPanel><Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Projeto"/><TextBox x:Name="ProjectName" Text="meus-textos" Margin="0,5,10,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Idioma original"/><ComboBox x:Name="SourceLanguage" SelectedIndex="0" Margin="0,5,10,0"><ComboBoxItem Content="auto"/><ComboBoxItem Content="coreano"/><ComboBoxItem Content="chinês"/><ComboBoxItem Content="japonês"/><ComboBoxItem Content="inglês"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Destino"/><ComboBox x:Name="TargetLanguage" SelectedIndex="0" Margin="0,5,0,0"><ComboBoxItem Content="pt-BR"/><ComboBoxItem Content="en"/><ComboBoxItem Content="es"/></ComboBox></StackPanel></Grid><Button Grid.Row="3" Content="Iniciar tradução" Click="StartDocument_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></Grid></TabItem>
      <TabItem Header="Vídeo / Áudio"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Cria transcrição e legenda pt-BR; o arquivo original é preservado." TextWrapping="Wrap" Margin="0,0,0,12"/><DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="Escolher mídia" Click="ChooseMedia_Click" Margin="10,0,0,0"/><TextBox x:Name="MediaPath" VerticalContentAlignment="Center"/></DockPanel><Button Grid.Row="2" Content="Transcrever e traduzir" Click="StartMedia_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></Grid></TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#151F2E" BorderBrush="#2C3B51" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16,0,0"><DockPanel><ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="180" Height="8" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Pronto." TextWrapping="Wrap"/></DockPanel></Border>
  </Grid>
</Window>
