<Window x:Class="Mike.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Mike Local" Height="800" Width="1200"
        WindowStyle="None" ResizeMode="CanResize" WindowState="Maximized">
    <Grid Background="#10131A">
        <wv2:WebView2 Name="webView" Visibility="Collapsed" />
        <Border Name="startupPanel" Background="#10131A" Padding="48">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680">
                <TextBlock Text="Mike Local" Foreground="#26D9FF" FontSize="38" FontWeight="Bold" />
                <TextBlock Name="startupStage" Text="Abrindo o aplicativo..." Foreground="#F5F7FF" FontSize="20" Margin="0,18,0,8" />
                <TextBlock Name="startupDetail" Text="Verificando os componentes da interface." Foreground="#AAB3C5" FontSize="14" TextWrapping="Wrap" />
                <ProgressBar Name="startupProgress" Height="12" Margin="0,22,0,0" IsIndeterminate="True" Foreground="#26D9FF" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
